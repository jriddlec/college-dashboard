# Copy to .env and edit. Everything here is optional except where noted.

# --- Your school ---------------------------------------------------------
# fixture (demo data) | d2l (Brightspace / D2L, docs/d2l.md) | canvas (docs/canvas.md)
LMS=fixture
# Your LMS address, as in the browser (required for d2l/canvas).
LMS_URL=https://school.brightspace.com
# What students call it ("eLC", "iCollege", "D2L"...). Defaults to Brightspace/Canvas.
LMS_LABEL=
SCHOOL_NAME=
APP_NAME=College Dashboard
# Brand color (hex, quoted: an unquoted # starts a comment). Default is blue.
ACCENT_COLOR=""
# Your school's time zone, for due dates and "today".
SCHOOL_TZ=America/New_York

# Start the sync with the app: d2l (sign-in session + sync) or canvas.
#COMPOSE_PROFILES=d2l
SYNC_INTERVAL=1800

# Canvas only: your personal access token (Canvas -> Account -> Settings ->
# New Access Token). Keep this file private; only canvas-sync receives it.
CANVAS_TOKEN=

# --- Folders on this machine ----------------------------------------------
# Class folders (read-only to the app). The example library goes with the demo
# data; point this at where you keep your own class folders.
LIBRARY_DIR=./examples/library
# Optional settings files (see config/*.example.json).
CONFIG_DIR=./config
# Synced LMS data, PDF previews of Office files, and the D2L sign-in session.
DATA_DIR=./data
PREVIEWS_DIR=./previews
D2L_AUTH_DIR=./d2l-auth
# The user/group that owns DATA_DIR, PREVIEWS_DIR and D2L_AUTH_DIR (run `id`).
PUID=1000
PGID=1000

# --- Ports ----------------------------------------------------------------
# Loopback only by default. To reach it from other devices on your network,
# use 0.0.0.0:3000 (or put a reverse proxy in front). Never expose it to the
# internet: it shows your grades and has no login.
WEB_PORT=127.0.0.1:3000
NOVNC_PORT=127.0.0.1:6080
